// pin tutorial
"main_window_intro_short" = "บทนำ";
"main_window_intro" = "หน้าต่างหลัก - หน้าต่างคงที่ที่มีความสามารถในการจัดระเบียบและจัดการเนื้อหาที่ทรงพลัง";
"main_window_intro_desc" = "หน้าต่างหลักเป็นหน้าต่างคงที่บนหน้าจอที่ช่วยให้คุณสามารถดำเนินการจัดการและใช้บันทึกคลิปบอร์ดได้เป็นกลุ่ม\nกรอง: กรองรายการที่แสดงตามแอป + รายการได้อย่างอิสระ\nค้นหา: ค้นหาอย่างรวดเร็วภายในขอบเขตการกรอง\nการเลือก: คลิกซ้ายเพื่อเลือกหนึ่งรายการ; ⌘+คลิกเพื่อเพิ่มรายการ; ⇧+คลิกเพื่อเพิ่มรายการทั้งหมดระหว่างการเลือกสองรายการ;\nวาง: ดับเบิลคลิกเพื่อวางรายการเดียว; ลากและวางหรือเมนูคลิกขวาเพื่อดำเนินการกลุ่มหลายรายการ.";
"main_window_follow_frontmost" = "ติดตามแอปที่อยู่ด้านหน้าโดยอัตโนมัติ";
"main_window_follow_frontmost_desc" = "เมื่อเลือกโหมดติดตามแอปที่อยู่ด้านหน้า ตัวกรองแอปจะติดตามการเปลี่ยนแปลงของแอปที่อยู่ด้านหน้าและแสดงประวัติคลิปบอร์ดของแอปนั้น\nโหมดนี้เมื่อใช้กับรายการสามารถสร้างความเป็นไปได้มากมายและจัดเตรียมพื้นที่เฉพาะสำหรับแต่ละแอป เปิดศักยภาพของแอป.";
"main_window_youtubelinks_short" = "รายการอัจฉริยะ";
"main_window_youtubelinks" = "รายการอัจฉริยะ - การกรองรายการอย่างชาญฉลาดตามเงื่อนไข";
"main_window_youtubelinks_desc" = "ด้วยรายการอัจฉริยะ คุณสามารถตั้งค่าเงื่อนไขการกรองได้อย่างอิสระเพื่อให้ได้เนื้อหาที่ต้องการ.\nเงื่อนไขการกรองที่รองรับในปัจจุบัน ได้แก่ ประเภทสื่อ, การจับคู่คำสำคัญ, การจับคู่ด้วยนิพจน์ปกติ, ความยาวตัวอักษร, แอปต้นทาง, อุปกรณ์ต้นทาง และตำแหน่งในคอลเลกชัน.";
"main_window_manual_collection" = "รายการคอลเลกชัน - การจัดการด้วยตนเอง";
"main_window_manual_collection_desc" = "เลือก 'รายการ' หนึ่งรายการหรือมากกว่า คลิกขวาและเลือก 'เพิ่มในรายการ' เพื่อบันทึกลงในรายการเฉพาะ.\nรายการคอลเลกชันสามารถกรองโดยรายการอัจฉริยะ ทำให้มีความเป็นไปได้มากขึ้น.";
"main_window_sketch" = "รายการคอลเลกชัน - การเก็บรวบรวมอัตโนมัติ";
"main_window_sketch_desc" = "เลือกรายการคอลเลกชัน เปิดใช้งานตัวเลือกการเก็บรวบรวมอัตโนมัติด้านล่าง และเนื้อหาที่คุณคัดลอกจะถูกบันทึกโดยอัตโนมัติไปยังรายการที่กำหนด.\nคุณสามารถตั้งชื่อเล่นให้กับมัน ทำให้เข้าถึงรายการได้ง่ายเมื่อคุณต้องการ.\nแอปหลายตัว โดยเฉพาะแอปสร้างเนื้อหา เช่น Sketch และ Final Cut Pro ขาดฟีเจอร์การเก็บรวบรวมที่สะดวก.\nหากแอปที่คุณชื่นชอบไม่รองรับการเก็บรวบรวม ฟีเจอร์นี้จะมีประโยชน์อย่างมากสำหรับคุณ!";

