// pin tutorial
"main_window_intro_short" = "Introducción";
"main_window_intro" = "Ventana Principal - Una ventana fija con potentes capacidades de organización y gestión de contenido";
"main_window_intro_desc" = "La Ventana Principal es una ventana fija en la pantalla que te permite operar, gestionar y utilizar registros del portapapeles en lote.\nFiltro: Filtra libremente los elementos mostrados según App + Lista.\nBúsqueda: Busca rápidamente dentro del rango de filtrado.\nSelección: Haz clic izquierdo para seleccionar un solo elemento; ⌘+clic para agregar un elemento; ⇧+clic para agregar todos los elementos entre dos selecciones;\nPegar: Haz doble clic para pegar un solo elemento; arrastra y suelta o menú de clic derecho para operar en lote múltiples elementos.";
"main_window_follow_frontmost" = "Seguir Automáticamente la Aplicación en Primer Plano";
"main_window_follow_frontmost_desc" = "Al seleccionar el modo Seguir la Aplicación en Primer Plano, el filtro de la aplicación seguirá automáticamente los cambios de la aplicación en primer plano y mostrará el historial del portapapeles de esa aplicación.\nEste modo, cuando se usa con listas, puede crear muchas posibilidades y proporcionar espacios dedicados para cada aplicación, desbloqueando el potencial de la aplicación.";
"main_window_youtubelinks_short" = "Listas Inteligentes";
"main_window_youtubelinks" = "Listas Inteligentes - Filtrado inteligente de elementos basado en condiciones";
"main_window_youtubelinks_desc" = "Con Listas Inteligentes, puedes establecer libremente condiciones de filtrado para obtener el contenido deseado.\nLas condiciones de filtrado actualmente soportadas incluyen: tipo de medio, coincidencia de palabras clave, coincidencia de expresiones regulares, longitud de caracteres, aplicación de origen, dispositivo de origen y ubicación en la colección.";
"main_window_manual_collection" = "Listas de Colección - Gestión Manual";
"main_window_manual_collection_desc" = "Selecciona uno o más 'elementos', haz clic derecho y elige 'Agregar a Listas' para guardarlos en listas específicas.\nLas listas de colección pueden ser filtradas por listas inteligentes, permitiendo más posibilidades.";
"main_window_sketch" = "Listas de Colección - Colección Automática";
"main_window_sketch_desc" = "Selecciona una lista de colección, activa la opción de colección automática a continuación, y cualquier contenido que copies se guardará automáticamente en la lista especificada.\nPuedes establecer un alias para ello, facilitando el acceso a la lista siempre que lo necesites.\nMuchas aplicaciones, especialmente aplicaciones de creación de contenido como Sketch y Final Cut Pro, carecen de una función de colección conveniente.\nSi tus aplicaciones favoritas no soportan colecciones, ¡esta función será extremadamente útil para ti!";

